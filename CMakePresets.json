{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "BB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "native",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "displayName": "Host desktop build"
    },
    {
      "name": "macos-arm64",
      "inherits": "native",
      "displayName": "macOS Apple Silicon",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "headless",
      "inherits": "native",
      "displayName": "C-only gameplay tests without graphics dependencies",
      "cacheVariables": {
        "BB_BUILD_GAME": "OFF"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "headless",
      "displayName": "Gameplay tests with ASan and UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BB_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "windows-x64",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "displayName": "Windows x86_64 / AMD64 (MSVC)"
    },
    {
      "name": "windows-x86",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "displayName": "Windows x86 (MSVC)"
    },
    {
      "name": "windows-debug-x64",
      "inherits": "windows-x64",
      "displayName": "Windows x86_64 / AMD64 (MSVC, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-debug-x86",
      "inherits": "windows-x86",
      "displayName": "Windows x86 (MSVC, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-cross-base",
      "inherits": "native",
      "hidden": true,
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm-mingw.cmake",
      "cacheVariables": {
        "BB_LLVM_MINGW_ROOT": "$env{BB_LLVM_MINGW_ROOT}"
      }
    },
    {
      "name": "windows-cross-x64",
      "inherits": "windows-cross-base",
      "displayName": "Windows AMD64 cross build (LLVM-MinGW)",
      "cacheVariables": {
        "BB_WINDOWS_ARCH": "x86_64"
      }
    },
    {
      "name": "windows-cross-x86",
      "inherits": "windows-cross-base",
      "displayName": "Windows x86 cross build (LLVM-MinGW)",
      "cacheVariables": {
        "BB_WINDOWS_ARCH": "i686"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "windows-debug-x64",
      "configurePreset": "windows-debug-x64",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "windows-debug-x86",
      "configurePreset": "windows-debug-x86",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "windows-cross-x64",
      "configurePreset": "windows-cross-x64",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "windows-cross-x86",
      "configurePreset": "windows-cross-x86",
      "configuration": "Release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
