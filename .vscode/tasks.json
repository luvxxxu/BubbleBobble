{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: 기본 대상 구성",
            "type": "process",
            "command": "${workspaceFolder}/scripts/cmake.sh",
            "args": [
                "--preset",
                "macos-arm64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ],
            "windows": {
                "command": "cmake",
                "args": [
                    "--preset",
                    "windows-x64"
                ]
            }
        },
        {
            "label": "CMake: BubbleBobble 빌드",
            "type": "process",
            "command": "${workspaceFolder}/scripts/cmake.sh",
            "args": [
                "--build",
                "--preset",
                "macos-arm64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: 기본 대상 구성",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "command": "cmake",
                "args": [
                    "--build",
                    "--preset",
                    "windows-x64"
                ]
            }
        },
        {
            "label": "CMake: Windows x64 구성",
            "type": "cmake",
            "command": "configure",
            "preset": "windows-x64",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Windows x64 빌드",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "windows-x64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Windows x64 구성",
            "dependsOrder": "sequence",
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "CMake: Windows x86 구성",
            "type": "cmake",
            "command": "configure",
            "preset": "windows-x86",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Windows x86 빌드",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "windows-x86"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Windows x86 구성",
            "dependsOrder": "sequence",
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "CMake: Windows x64 디버그 구성",
            "type": "cmake",
            "command": "configure",
            "preset": "windows-debug-x64",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Windows x64 디버그 빌드",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "windows-debug-x64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Windows x64 디버그 구성",
            "dependsOrder": "sequence",
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "CMake: Windows x86 디버그 구성",
            "type": "cmake",
            "command": "configure",
            "preset": "windows-debug-x86",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Windows x86 디버그 빌드",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "windows-debug-x86"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Windows x86 디버그 구성",
            "dependsOrder": "sequence",
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
